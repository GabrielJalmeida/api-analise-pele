# Nunca coloque a chave real neste arquivo ou no repositório.
GEMINI_API_KEY=

# Modelo padrão do projeto. Altere por ambiente quando necessário.
GEMINI_MODEL=gemini-3.5-flash-lite

# Use production apenas no backend publicado.
APP_ENV=development

# Deixe vazio no ambiente local para usar produtos.db na raiz.
# No Railway, use o caminho do volume persistente.
DATABASE_PATH=

# Origens autorizadas a acessar a API pelo navegador.
# Separe múltiplas origens por vírgula.
CORS_ORIGINS=http://localhost:5173