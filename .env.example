# Provedor ativo: gemini, openai ou anthropic.
# "claude" também é aceito como apelido de anthropic.
AI_PROVIDER=gemini

# Nunca coloque chaves reais neste arquivo ou no repositório.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos padrão. Somente o modelo do provedor ativo será usado.
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ambientes aceitos: development ou production.
APP_ENV=development

# Deixe vazio no desenvolvimento para usar produtos.db na raiz.
# Em produção, aponte para um volume persistente.
DATABASE_PATH=

# Diretório opcional para imagens. Vazio usa media/ no projeto.
MEDIA_PATH=

# Pedidos do site são demonstrativos. Por padrão não reduzem estoque.
PEDIDOS_ATUALIZAM_ESTOQUE=false

# Origens autorizadas a acessar a API pelo navegador.
# Separe múltiplas origens por vírgula.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
